<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fundo glass mais leve -->
    <item>
        <shape>
            <solid android:color="#66E3F2FD"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>

    <!-- Brilho superior (reflexo) -->
    <item android:bottom="100dp">
        <shape>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#80FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="22dp"/>
        </shape>
    </item>

    <!-- Borda -->
    <item>
        <shape>
            <corners android:radius="22dp"/>
            <stroke android:width="1dp" android:color="#99FFFFFF"/>
        </shape>
    </item>

</layer-list>